# Google Cloud Console で取得したAPIキー。
# Places API (New) を有効化し、キーにAPI制限・アプリケーション制限をかけること(要件書22章)。
GOOGLE_MAPS_API_KEY=your_api_key_here

# Postgres接続情報。Vercel PostgresまたはNeon等を作成すると自動で払い出される。
# ローカル開発でVercel連携済みの場合は `vercel env pull .env.local` で取得するのが簡単。
# @vercel/postgres は POSTGRES_URL を自動的に参照する。
POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- ここからCapacitor(モバイルアプリ)関連 ---

# モバイルアプリからAPIを呼ぶ際の絶対URL。Web版(Vercel上)では未設定のままでよい
# (相対パスのままVercel自身のAPIを呼ぶため)。
#
# 【重要】 npm run build:mobile を実行する前に、必ずこの値を設定すること。
# 未設定のままモバイルビルドすると、scripts/build-mobile.mjs がビルド自体を失敗させる
# (ここで検知せずビルドが通ってしまうと、アプリ内蔵ページの fetch("/api/...") が
#  Vercelではなくアプリ自身のWebView(https://localhost)に向いてしまい、
#  実機/エミュレーターで原因の分かりにくいエラーになるため)。
#
# この .env.local はローカルの `npm run dev`/`npm run build`(Web版)でも読み込まれるため、
# ここに恒久的に設定すると、ローカルのWeb版動作確認時もこのURL宛にAPIを呼ぶようになる点に注意。
# (Vercel本番環境自体はこの.env.localの影響を受けない。Vercel側の環境変数として
#  NEXT_PUBLIC_API_BASE_URL を設定しない限り、Web版は相対パスのまま動作する。)
# Web版のローカル動作に影響させたくない場合は、ここは空のままにしておき、
# 実行時に一時的な環境変数として指定するとよい(build-mobile実行時のエラーメッセージ内に
# Windows PowerShell / macOS・Linux それぞれのコマンド例を表示している)。
#
# 例: NEXT_PUBLIC_API_BASE_URL=https://drive-travel-planner.vercel.app
NEXT_PUBLIC_API_BASE_URL=

# Capacitorアプリ(iOS/Android)からのAPIアクセスを許可するオリジンのカンマ区切りリスト。
# 未設定の場合は middleware.ts のデフォルト値(capacitor://localhost 等)が使われる。
ALLOWED_MOBILE_ORIGINS=capacitor://localhost,http://localhost,https://localhost

