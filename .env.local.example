# Google Cloud Console で取得したAPIキー。
# Places API (New) を有効化し、キーにAPI制限・アプリケーション制限をかけること(要件書22章)。
GOOGLE_MAPS_API_KEY=your_api_key_here

# Postgres接続情報。Vercel PostgresまたはNeon等を作成すると自動で払い出される。
# ローカル開発でVercel連携済みの場合は `vercel env pull .env.local` で取得するのが簡単。
# @vercel/postgres は POSTGRES_URL を自動的に参照する。
POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require
